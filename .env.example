# Supabase configuration for the Vite client.
# These VITE_* values are PUBLISHABLE / client-safe keys — they are compiled
# into the browser bundle and exposed to every visitor by design. Do NOT put
# the Supabase service-role key (or any secret) here; those belong in the
# Supabase Edge Function secrets, read via Deno.env at runtime.
#
# Copy this file to `.env` and fill in your project's values:
#   cp .env.example .env

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
